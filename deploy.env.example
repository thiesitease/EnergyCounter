# Zugangsdaten für deploy.sh. Diese Datei als  deploy.env  kopieren und ausfüllen.
# deploy.env gehört nicht ins Git und nicht in einen Chat.

MODE=sftp                        # sftp (mit SSH-Schlüssel) oder ftp

HOST=                            # SSH- bzw. FTP-Host des Anbieters
USER=                            # Benutzername
# Adresse der Installation, nur für die Hinweise am Ende der Skripte
SITE_URL=https://deine-domain.example

REMOTE_DIR=/htdocs               # Webverzeichnis der Domain auf dem Server

# Nur bei MODE=sftp:
SSH_KEY=~/.ssh/zaehlerbuch       # der öffentliche Teil gehört ins Kundenmenü des Anbieters

# Nur bei MODE=ftp:
FTP_PASSWORD=
